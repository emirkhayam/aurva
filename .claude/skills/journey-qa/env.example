# Copy to .env (gitignored):  cp env.example .env
# NEVER commit real secrets.

# Target hosts (override config.base_url / admin_base_url at runtime)
JOURNEY_BASE=https://your-app.example.com
JOURNEY_ADMIN_BASE=https://your-app.example.com

# Single shared password for all fixture/test users.
# Use ONLY throwaway QA accounts on a staging/test tenant — never real user creds.
TEST_PASSWORD=

# Optional: path to your config file (defaults to ./journey-qa.config.json)
# JOURNEY_CONFIG=./journey-qa.config.json
